# Copy this file to .env and adjust the values for your environment.
# Jenkins overwrites .env on every build from the job parameters.

# TaskHub application URL (protocol + host + port, no trailing slash)
BASE_URL=https://taskhub.azcentrix.com:4453

# Login page path, appended to BASE_URL
LOGIN_URL=/login

# true = run browsers without a window (CI); false = open a visible browser (local debugging)
HEADLESS=false
