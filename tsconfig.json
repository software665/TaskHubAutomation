{
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "ES2020",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@data/*": ["test-data-management/*"],
      "@pages/*": ["page-objects/*"],
      "@testcases/*": ["src/test-cases/*"],
      "@utils/*": ["src/utilis/*"]

    }
  }
}